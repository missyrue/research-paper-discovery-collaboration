MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=atlas_research
MYSQL_USER=atlas_app
MYSQL_PASSWORD=replace-with-local-app-password
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
OPENAI_API_KEY=replace-with-your-embedding-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=research_papers
MONGODB_COLLECTION=paper_vectors
ATLAS_VECTOR_INDEX=paper_embedding_index
